# ============================================================
# Serverless URL Shortener - .gitignore
# ============================================================

# --- .NET / Backend ---
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates
*.dotnetcli
.vs/
*.dbmdl
*.jfm

# Build outputs
*.dll
*.exe
*.pdb
*.xml
*.props
*.targets

# Test results
*.trx
*.xml
TestResults/
coverage/
*.coverage
*.coveragexml

# NuGet
packages/
*.nupkg
*.snupkg
nuget.config

# --- Terraform ---
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfplan
terraform/*.tfplan.*
terraform/*.backup
*.tfvars
*.tfvars.json
!terraform/environments/*/terraform.tfvars.example

# Terraform providers
.terraform/providers/

# --- Docker ---
.docker/
docker-compose.override.yml
docker-compose.*.yml
!docker-compose.yml
!docker-compose.override.yml.example

# --- Node.js / Frontend ---
frontend/node_modules/
frontend/build/
frontend/.cache/
frontend/.eslintcache
frontend/.parcel-cache/
frontend/dist/
frontend/coverage/
frontend/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm
.eslintcache

# --- Environment & Secrets ---
.env
.env.local
.env.*.local
.env.production
.env.development
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
*.secret

# --- IDE & Editors ---
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.swp
*.swo
*~
*.sublime-workspace
*.sublime-project
.project
.classpath
.settings/
*.iml

# --- OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Logs ---
*.log
logs/
*.log.*

# --- LocalStack / Local Development ---
localstack-data/
.localstack/
localstack-init/*.log

# --- Temporary Files ---
*.tmp
*.temp
tmp/
temp/
*.bak
*.backup

# --- Coverage Reports ---
coverage/
.nyc_output/
*.lcov

# --- Database ---
*.sqlite
*.sqlite3
*.db

# --- OS Specific ---
*.orig
*.rej

# --- Terraform State Lock (if using local backend) ---
*.tfstate.lock.info

# --- VS Code / Cursor specific ---
.vscode/settings.json.local
.vscode/launch.json.local

# --- Git ---
.git-blame-ignore-revs
.git-shallow

# --- CI/CD ---
.github/workflows/*.yml.bak
.github/workflows/*.yaml.bak

# --- Backup files ---
*~
*.bak
*.swp
*.tmp

# --- Misc ---
*.pid
*.seed
*.pid.lock